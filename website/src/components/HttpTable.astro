---
interface HttpRoute {
  method: string;
  path: string;
  desc: string;
}
interface HttpGroup {
  group: string;
  routes: HttpRoute[];
}
interface Props {
  groups: HttpGroup[];
}
const { groups } = Astro.props;

const inline = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>');
---

{
  groups.map((group) => (
    <>
      <p class="http__group">{group.group}</p>
      <table class="http">
        <thead>
          <tr>
            <th scope="col">Method</th>
            <th scope="col">Path</th>
            <th scope="col">Description</th>
          </tr>
        </thead>
        <tbody>
          {group.routes.map((route) => (
            <tr>
              <td class="http__method">{route.method}</td>
              <td>
                <code>{route.path}</code>
              </td>
              <td>
                <span set:html={inline(route.desc)} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ))
}

<style>
  .http {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    margin: 0 0 1.4rem;
  }
  .http th,
  .http td {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--line-soft);
    text-align: left;
    vertical-align: top;
  }
  .http thead th {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .http tbody td:nth-child(2) {
    white-space: nowrap;
  }
  .http__method {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .http__group {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin: 1.2rem 0 0.4rem;
  }
</style>
